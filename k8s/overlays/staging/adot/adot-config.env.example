# Copy this file to adot-config.env (gitignored) and fill in from terraform output.
# From repo root after terraform apply:
#   AWS_REGION=us-east-1
#   AMP_REMOTE_WRITE_URL=$(terraform -chdir=terraform output -raw amp_remote_write_url)
#   IRSA_ROLE_ARN=$(terraform -chdir=terraform output -raw amp_remote_write_irsa_role_arn)
AWS_REGION=us-east-1
AMP_REMOTE_WRITE_URL=https://aps-workspaces.<REGION>.amazonaws.com/workspaces/<WORKSPACE_ID>/api/v1/remote_write
IRSA_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/<PROJECT>-staging-amp-remote-write
