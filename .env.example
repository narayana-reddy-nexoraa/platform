# Copy to ".env" in this directory and replace values. ".env" is gitignored — never commit secrets.
#
# Docker Compose host URLs (container ports stay 8080/8081 inside the network):
#   API http://localhost:18080   UI http://localhost:13002   Grafana http://localhost:13001
DATABASE_URL=replace me
SERVER_PORT=replace me
LOG_LEVEL=replace me
LEASE_DURATION_SECONDS=replace me
CLAIM_BATCH_SIZE=replace me
WORKER_ID=replace me
HEALTH_PORT=replace me
GF_SECURITY_ADMIN_PASSWORD=replace me
SHUTDOWN_TIMEOUT_SECONDS=replace me
FAILURE_RATE=replace me
