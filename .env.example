# Copy to ".env" in this directory and replace values. ".env" is gitignored — never commit secrets.
#
# Docker Compose host URLs (container ports stay 8080/8081 inside the network):
#   API http://localhost:18080   UI http://localhost:13002   Grafana http://localhost:13001
DATABASE_URL="replace_me"
SERVER_PORT="replace_me"
LOG_LEVEL="replace_me"
LEASE_DURATION_SECONDS="replace_me"
CLAIM_BATCH_SIZE="replace_me"
WORKER_ID="replace_me"
HEALTH_PORT="replace_me"
GF_SECURITY_ADMIN_PASSWORD="replace_me"
GRAFANA_ADMIN_PASSWORD="replace_me"
SHUTDOWN_TIMEOUT_SECONDS="replace_me"
FAILURE_RATE="replace_me"
